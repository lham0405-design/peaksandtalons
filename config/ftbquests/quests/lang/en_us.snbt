{
	chapter_group.A100000000000001.title:"Peaks & Talons"
	chapter_group.A100000000000002.title:"The High Peaks"
	chapter.B100000000000001.title:"The Journey Begins"
	chapter.B100000000000002.title:"Lord of the Skies"
	quest.C100000000000001.title:"A Place to Begin"
	quest.C100000000000001.quest_desc:["Build the basics. The paths ahead are optional preparation for the greater adventure."]
	quest.C100000000000002.title:"Gearing Up"
	quest.C100000000000002.quest_desc:["Armor matters. The creatures of the peaks will not treat an unprepared traveler kindly."]
	quest.C100000000000003.title:"Hold the Line"
	quest.C100000000000003.quest_desc:["A shield is useful preparation before seeking dangerous wildlife."]
	quest.C100000000000004.title:"Food for the Road"
	quest.C100000000000004.quest_desc:["Carry a dependable food supply before traveling far from home."]
	quest.C100000000000005.title:"A Better Meal"
	quest.C100000000000005.quest_desc:["Farmer's Delight expands your kitchen. Learn to prepare meals worthy of a long expedition."]
	quest.C100000000000006.title:"Faster Smelting"
	quest.C100000000000006.quest_desc:["Iron Furnaces is useful support progression, not a requirement of the Peaks & Talons story."]
	quest.C100000000000007.title:"Village Life Made Easy"
	quest.C100000000000007.quest_desc:["Easy Villagers can streamline your settlement while you prepare for larger adventures."]
	quest.C200000000000001.title:"A Choice Beneath the Wings"
	quest.C200000000000001.quest_desc:["You have reached a defining choice. The Eagle can become your greatest quarry or your greatest companion — but not both. Completing either Path of the Hunter or Path of the Bond permanently closes the other branch for this progression. Read both paths before acting.","HUNTER: Damage the Eagle and commit to its boss encounter. BOND: Do not harm the Eagle; approach with salmon and endure its difficult taming trials."]
	quest.C200000000000002.title:"Path of the Hunter — Commit to Battle"
	quest.C200000000000002.quest_desc:["WARNING — EXCLUSIVE CHOICE: Beginning the Hunter path means you have chosen to fight the Eagle. Once this branch is completed, Path of the Bond becomes unavailable.","Strike the Eagle and prepare for a boss battle. Defeating the first Eagle will unleash the storm-born Vengeance phase."]
	quest.C200000000000003.title:"Vengeance"
	quest.C200000000000003.quest_desc:["The sky answers your challenge. Rain, thunder and lightning herald the second phase as three enraged Eagles descend. Defeat the Vengeance encounter to complete the Hunter route."]
	quest.C200000000000004.title:"Path of the Bond — Earn Its Trust"
	quest.C200000000000004.quest_desc:["WARNING — EXCLUSIVE CHOICE: The Bond path is for players who choose not to fight the Eagle. Do not damage it. Once this branch is completed, Path of the Hunter becomes unavailable.","Offer salmon peacefully. Acceptance only grants you the chance to attempt the true taming trial — it does not tame the Eagle immediately."]
	quest.C200000000000005.title:"Survive the Taming Trial"
	quest.C200000000000005.quest_desc:["Mount the untamed Eagle and hold on. It may climb, dive, buck, take to the air and throw you from dangerous heights. Multiple attempts may be required before this boss-class creature accepts you."]
	quest.C200000000000006.title:"Take to the Skies"
	quest.C200000000000006.quest_desc:["Your bond is complete. Equip your Eagle for riding and complete your first controlled flight. You chose companionship over the Hunter rewards — and gained a majestic flying ally instead."]
}
