 quest.C100000000000001.title: "Welcome to Peaks & Talons"
 quest.C100000000000001.quest_desc: ["The mountains are the road ahead. Prepare before you answer the Call of the Peaks."]
 quest.C100000000000002.title: "Gear Up"
 quest.C100000000000002.quest_desc: ["Mountain predators punish poor preparation. Craft iron armor before climbing into eagle country."]
 quest.C100000000000003.title: "A Shield Against the Peaks"
 quest.C100000000000003.quest_desc: ["A shield can buy the second you need when the mountain fights back."]
 quest.C100000000000004.title: "Pack Food"
 quest.C100000000000004.quest_desc: ["Do not climb hungry. Carry reliable food before leaving the lowlands."]
 quest.C100000000000005.title: "Farmer's Delight"
 quest.C100000000000005.quest_desc: ["Optional support progression for longer expeditions; not part of the main boss story."]
 quest.C100000000000006.title: "Iron Furnaces"
 quest.C100000000000006.quest_desc: ["Faster smelting makes gearing and engineering less painful."]
 quest.C100000000000007.title: "Easy Villagers"
 quest.C100000000000007.quest_desc: ["Build a safer trading network before the dangerous mountain chapters begin."]
 quest.C200000000000001.title: "The Call of the Peaks"
 quest.C200000000000001.quest_desc: ["Mountain Eagles are rare. Search the highest peaks and watch the sky.","Your choice matters: HUNT the Eagle or BOND with it. Read both paths before acting."]
 quest.C200000000000002.title: "HUNT — Challenge the Eagle"
 quest.C200000000000002.quest_desc: ["&cCHOICE: HUNT&r","Killing the Eagle commits you to combat. Vengeance will answer its death."]
 quest.C200000000000003.title: "Vengeance from Above"
 quest.C200000000000003.quest_desc: ["Three Vengeance Eagles descend in storm and thunder. Watch their dives and keep moving."]
 quest.C200000000000004.title: "BOND — Earn Its Trust"
 quest.C200000000000004.quest_desc: ["&aCHOICE: BOND&r","Do not harm the Eagle. Offer salmon and endure its taming trials."]
 quest.C200000000000005.title: "Bond of the Summit"
 quest.C200000000000005.quest_desc: ["Mounting is only the beginning. Stay with the Eagle long enough for it to accept you."]
 quest.C200000000000006.title: "First Flight"
 quest.C200000000000006.quest_desc: ["Take to the sky with your bonded Eagle and learn controlled flight."]
 quest.C200000000000007.title: "Compass Materials"
 quest.C200000000000007.quest_desc: ["Both Hunt and Bond lead forward. Mill an Eagle Talon into Crushed Talon, then use Crushing Wheels to make Talon Dust.","Talon Dust replaces redstone in the Explorer's Compass recipe."]
 quest.C300000000000001.title: "Eye of the Eagle"
 quest.C300000000000001.quest_desc: ["The blue Eye is a true Eagle relic. Bonded players may later hunt another rare Eagle if they choose to obtain one."]
 quest.C300000000000002.title: "Storm Crystal"
 quest.C300000000000002.quest_desc: ["Capture the fury of the upper peaks in crystalline form."]
 quest.C300000000000003.title: "Ancient Talon"
 quest.C300000000000003.quest_desc: ["A relic from the oldest rulers of the peaks."]
 quest.C300000000000004.title: "Eye of the Summit"
 quest.C300000000000004.quest_desc: ["Unite the Eye of the Eagle with the other summit relics. The Eagle remains central to this progression."]
 quest.C300000000000005.title: "Golden Eagle Harness"
 quest.C300000000000005.quest_desc: ["A ceremonial harness worthy of a fully bonded Eagle."]
 quest.C300000000000006.title: "Mill the Talon"
 quest.C300000000000006.quest_desc: ["Run an Eagle Talon through Create's Millstone to produce Crushed Talon."]
 quest.C300000000000007.title: "Crush It to Dust"
 quest.C300000000000007.quest_desc: ["Run Crushed Talon through Crushing Wheels. Talon Dust is the final Compass ingredient."]
 quest.C400000000000001.title: "The Explorer's Compass"
 quest.C400000000000001.quest_desc: ["Craft the Explorer's Compass with Eagle Feather and Talon Dust in place of redstone.","&eThere is no fast travel. Locate Orduk's Cave, then make the journey yourself.&r"]
 quest.C400000000000002.title: "Find Orduk's Cave"
 quest.C400000000000002.quest_desc: ["Search the Explorer's Compass for Orduk's Cave. Gear up before entering; Orduk is tougher than the entire Eagle encounter."]
 quest.C400000000000003.title: "ORDUK, THE CAVE TROLL"
 quest.C400000000000003.quest_desc: ["&cBOSS ENCOUNTER&r","Orduk is short, broad, goblin-armored and far faster than he looks.","Learn his Ground Slam, Backhand Sweep, Troll Charge, Boulder Throw and Leap. At half health, the battle becomes a violent mountain storm."]
 quest.C400000000000004.title: "Fallen Troll"
 quest.C400000000000004.quest_desc: ["Claim Orduk's Troll Heart. Keep it safe; it will become your guide toward the Griffin's mountain."]
 quest.C400000000000005.title: "Higher Horizons"
 quest.C400000000000005.quest_desc: ["&bCURRENT PLAYABLE STORY END&r","You survived the Eagles and defeated Orduk. The Griffin comes later."]
 quest.E200000000000001.title: "Andesite Beginnings"
 quest.E200000000000001.quest_desc: ["Create begins with Andesite Alloy."]
 quest.E200000000000002.title: "Cogwheels & Shafts"
 quest.E200000000000002.quest_desc: ["Transmit rotational power through your first mechanical network."]
 quest.E200000000000003.title: "Water Power"
 quest.E200000000000003.quest_desc: ["Build a Water Wheel for dependable rotational power."]
 quest.E200000000000004.title: "The Millstone"
 quest.E200000000000004.quest_desc: ["Required for Peaks & Talons: mill Eagle Talons into Crushed Talon."]
 quest.E200000000000005.title: "Mechanical Press"
 quest.E200000000000005.quest_desc: ["Unlock automated shaping and compacting."]
 quest.E200000000000006.title: "Depot"
 quest.E200000000000006.quest_desc: ["A work surface for Create processing."]
 quest.E200000000000007.title: "Encased Fan"
 quest.E200000000000007.quest_desc: ["The heart of Create's four bulk-processing systems."]
 quest.E200000000000008.title: "Bulk Washing"
 quest.E200000000000008.quest_desc: ["Pass fan-driven air through water."]
 quest.E200000000000009.title: "Bulk Smoking"
 quest.E200000000000009.quest_desc: ["Pass fan-driven air through a Campfire."]
 quest.E20000000000000A.title: "Bulk Haunting"
 quest.E20000000000000A.quest_desc: ["Pass fan-driven air through Soul Fire."]
 quest.E20000000000000B.title: "Bulk Smelting"
 quest.E20000000000000B.quest_desc: ["Pass fan-driven air through Lava. This is the intended forge for Talon Blades."]
 quest.E20000000000000C.title: "Forge the Talon Blade"
 quest.E20000000000000C.quest_desc: ["Forge the Eagle Talon into the weapon material used by Talonspire and Talonteer."]
 quest.E20000000000000D.title: "Precision Engineering"
 quest.E20000000000000D.quest_desc: ["Build a Precision Mechanism and enter advanced Create engineering."]
 quest.E20000000000000E.title: "Mechanical Crafters"
 quest.E20000000000000E.quest_desc: ["Build a Mechanical Crafter array. Eagle Eye and Dragon Eye necklaces require machinery beyond a crafting table."]

 quest.D310000000000001.title:"Iron Ready" quest.D310000000000001.quest_desc:["A full expedition starts with reliable armor. Iron is the minimum recommended protection before hunting the high peaks."]
 quest.D310000000000002.title:"Shield Discipline" quest.D310000000000002.quest_desc:["Carry a shield and learn when to block. Eagle dives and Orduk's telegraphed attacks reward active defense."]
 quest.D310000000000003.title:"Diamond Weapon" quest.D310000000000003.quest_desc:["Upgrade your primary weapon before serious boss hunting. Damage alone will not replace learning attack tells."]
 quest.D310000000000004.title:"Diamond Protection" quest.D310000000000004.quest_desc:["Diamond armor is the intended baseline for the later mountain encounters. Enchant it before challenging Orduk."]
 quest.D310000000000005.title:"Enchant for the Climb" quest.D310000000000005.quest_desc:["Build an enchanting setup. Protection, Feather Falling and weapon enchantments make the mountain much more forgiving."]

 quest.D320000000000001.title:"Gather the Harvest" quest.D320000000000001.quest_desc:["Farmer's Delight expands ordinary crops into useful expedition food. Start by establishing dependable ingredients."]
 quest.D320000000000002.title:"Knife & Cutting Board" quest.D320000000000002.quest_desc:["Craft a Farmer's Delight knife and cutting board. Cutting recipes turn raw ingredients into components and often produce useful byproducts."]
 quest.D320000000000003.title:"Cooking Pot" quest.D320000000000003.quest_desc:["The Cooking Pot combines ingredients into filling meals. Keep bowls available for recipes that need containers."]
 quest.D320000000000004.title:"Skillet & Heat" quest.D320000000000004.quest_desc:["Use Farmer's Delight cooking tools over valid heat sources. Build a compact kitchen before long expeditions."]
 quest.D320000000000005.title:"Pack an Expedition Meal" quest.D320000000000005.quest_desc:["Prepare high-saturation meals before entering boss territory. Food is support progression, but poor supplies make every encounter harder."]

 quest.D330000000000001.title:"Vanilla Furnace" quest.D330000000000001.quest_desc:["Iron Furnaces upgrades the familiar furnace into faster, more capable tiers."]
 quest.D330000000000002.title:"Iron Furnace" quest.D330000000000002.quest_desc:["Upgrade into the Iron tier. Higher tiers improve throughput and reduce waiting during gear and Create preparation."]
 quest.D330000000000003.title:"Gold Furnace" quest.D330000000000003.quest_desc:["Continue the furnace upgrade chain. Treat each tier as infrastructure rather than boss progression."]
 quest.D330000000000004.title:"Diamond Furnace" quest.D330000000000004.quest_desc:["Diamond-tier smelting is fast enough to support larger engineering projects and repeated equipment crafting."]
 quest.D330000000000005.title:"Netherite Furnace" quest.D330000000000005.quest_desc:["Reach the top conventional furnace tier and use upgrades/automation where useful for your base."]

 quest.D340000000000001.title:"Why Drawers?" quest.D340000000000001.quest_desc:["Storage Drawers excels at large quantities of a smaller number of item types: stone, ores, crops and Create materials."]
 quest.D340000000000002.title:"Build a Drawer Bank" quest.D340000000000002.quest_desc:["Place drawers together and organize bulk materials. Interact with drawer faces rather than treating them like ordinary chests."]
 quest.D340000000000003.title:"Capacity Upgrades" quest.D340000000000003.quest_desc:["Drawer upgrades increase how much a drawer can hold without expanding the footprint of your storage wall."]
 quest.D340000000000004.title:"Lock & Void Wisely" quest.D340000000000004.quest_desc:["Locking preserves an assigned item type. Void-style upgrades can destroy overflow, so use them only where excess is truly disposable."]
 quest.D340000000000005.title:"Controller Network" quest.D340000000000005.quest_desc:["A Drawer Controller provides a central interaction point for a connected drawer network and makes automation far cleaner."]

 quest.D350000000000001.title:"Your First Backpack" quest.D350000000000001.quest_desc:["Portable storage is extremely valuable in the mountains. Craft the backpack from your installed backpack mod and learn its open keybind."]
 quest.D350000000000002.title:"Upgrade the Pack" quest.D350000000000002.quest_desc:["Increase backpack capacity before long exploration trips. Keep emergency food and recovery supplies separate from loot."]
 quest.D350000000000003.title:"More Capacity" quest.D350000000000003.quest_desc:["Continue through the backpack material tiers as resources allow. Larger packs reduce forced returns from remote peaks."]
 quest.D350000000000004.title:"High-Tier Expedition Pack" quest.D350000000000004.quest_desc:["Prepare a high-capacity pack before searching distant structures such as Orduk's Cave."]
 quest.D350000000000005.title:"Backpack Upgrades" quest.D350000000000005.quest_desc:["Explore the installed backpack upgrades: pickup, feeding, filtering, stacking and other utility modules can automate expedition chores."]

 quest.D360000000000001.title:"Begin Digital Storage" quest.D360000000000001.quest_desc:["Refined Storage replaces sprawling chest rooms with a network. Begin by gathering its basic processor and quartz-based materials."]
 quest.D360000000000002.title:"Power the Network" quest.D360000000000002.quest_desc:["A Refined Storage network requires power. Plan continuous energy before trusting it with your main inventory."]
 quest.D360000000000003.title:"Controller & Grid" quest.D360000000000003.quest_desc:["The Controller manages the network and a Grid provides access. A Crafting Grid later combines storage access with crafting."]
 quest.D360000000000004.title:"Disk Drive & Storage Disks" quest.D360000000000004.quest_desc:["Disk Drives hold storage disks. Start small, then expand disk capacity as your expedition loot grows."]
 quest.D360000000000005.title:"Crafting Grid" quest.D360000000000005.quest_desc:["Use a Crafting Grid to craft directly from network contents instead of moving materials between containers."]
 quest.D360000000000006.title:"Import, Export & Automate" quest.D360000000000006.quest_desc:["Importers, Exporters, External Storage and later autocrafting let the network interact with machines and bulk storage."]

 quest.D370000000000001.title:"Apotheosis Begins" quest.D370000000000001.quest_desc:["Apotheosis greatly expands enchanting and equipment progression. Learn its modules gradually instead of treating every unfamiliar affix item as vendor trash."]
 quest.D370000000000002.title:"Advanced Enchanting" quest.D370000000000002.quest_desc:["Apotheosis changes enchanting through bookshelf statistics and specialized shelves. Build toward stronger enchantment setups deliberately."]
 quest.D370000000000003.title:"Affix Equipment" quest.D370000000000003.quest_desc:["Affix gear can carry powerful randomized bonuses. Compare the actual affixes and rarity rather than judging equipment only by vanilla material."]
 quest.D370000000000004.title:"Gems & Sockets" quest.D370000000000004.quest_desc:["Apotheosis gems provide bonuses when socketed into compatible affix equipment. Match gem effects to the slot and your build."]
 quest.D370000000000005.title:"Salvage & Reforge" quest.D370000000000005.quest_desc:["Salvaging unwanted affix gear feeds the reforging loop. Reforging lets you pursue stronger equipment rather than relying only on random drops."]
 quest.D370000000000006.title:"Boss-Ready Affixes" quest.D370000000000006.quest_desc:["Build a coherent set of enchanted and affixed equipment for late mountain encounters. Orduk should still require learning mechanics, not only stat stacking."]
}
