{
 chapter_group.A100000000000001.title: "PEAKS & TALONS — STORY"
 chapter_group.A100000000000002.title: "CREATE ENGINEERING"
 chapter.B100000000000001.title: "I — JOURNEY BEGINS"
 chapter.B100000000000001.chapter_subtitle: "Welcome • Gear & Progress • Food & Utility"
 chapter.B100000000000002.title: "II — LORD OF THE SKIES"
 chapter.B100000000000002.chapter_subtitle: "Call of the Peaks • Hunt or Bond • Eagle Relics"
 chapter.B100000000000003.title: "III — THE SUMMIT CALLS"
 chapter.B100000000000003.chapter_subtitle: "Create Engineering • Relics • The Road to Orduk"
 chapter.B100000000000004.title: "IV — MASTER OF THE PEAKS"
 chapter.B100000000000004.chapter_subtitle: "Mountain Threat • Orduk's Cave • Fallen Troll • Higher Horizons"
 chapter.B200000000000001.title: "CREATE — ENGINEERING THE PEAKS"
 chapter.B200000000000001.chapter_subtitle: "Power • Processing • Bulk Systems • Mechanical Crafting"

 quest.C100000000000001.title: "Welcome to Peaks & Talons"
 quest.C100000000000001.quest_desc: ["The mountains are the road ahead. Prepare before you answer the Call of the Peaks."]
 quest.C100000000000002.title: "Gear Up"
 quest.C100000000000002.quest_desc: ["Mountain predators punish poor preparation. Craft iron armor before climbing into eagle country."]
 quest.C100000000000003.title: "A Shield Against the Peaks"
 quest.C100000000000003.quest_desc: ["A shield can buy the second you need when the mountain fights back."]
 quest.C100000000000004.title: "Pack Food"
 quest.C100000000000004.quest_desc: ["Do not climb hungry. Carry reliable food before leaving the lowlands."]
 quest.C100000000000005.title: "Farmer's Delight"
 quest.C100000000000005.quest_desc: ["Optional support progression for longer expeditions; not part of the main boss story."]
 quest.C100000000000006.title: "Iron Furnaces"
 quest.C100000000000006.quest_desc: ["Faster smelting makes gearing and engineering less painful."]
 quest.C100000000000007.title: "Easy Villagers"
 quest.C100000000000007.quest_desc: ["Build a safer trading network before the dangerous mountain chapters begin."]

 quest.C200000000000001.title: "The Call of the Peaks"
 quest.C200000000000001.quest_desc: ["Mountain Eagles are rare. Search the highest peaks and watch the sky.","Your choice matters: HUNT the Eagle or BOND with it. Read both paths before acting."]
 quest.C200000000000002.title: "HUNT — Challenge the Eagle"
 quest.C200000000000002.quest_desc: ["&cCHOICE: HUNT&r","Killing the Eagle commits you to combat. Vengeance will answer its death."]
 quest.C200000000000003.title: "Vengeance from Above"
 quest.C200000000000003.quest_desc: ["Three Vengeance Eagles descend in storm and thunder. Watch their dives and keep moving."]
 quest.C200000000000004.title: "BOND — Earn Its Trust"
 quest.C200000000000004.quest_desc: ["&aCHOICE: BOND&r","Do not harm the Eagle. Offer salmon and endure its taming trials."]
 quest.C200000000000005.title: "Bond of the Summit"
 quest.C200000000000005.quest_desc: ["Mounting is only the beginning. Stay with the Eagle long enough for it to accept you."]
 quest.C200000000000006.title: "First Flight"
 quest.C200000000000006.quest_desc: ["Take to the sky with your bonded Eagle and learn controlled flight."]
 quest.C200000000000007.title: "Compass Materials"
 quest.C200000000000007.quest_desc: ["Both Hunt and Bond lead forward. Mill an Eagle Talon into Crushed Talon, then use Crushing Wheels to make Talon Dust.","Talon Dust replaces redstone in the Explorer's Compass recipe."]

 quest.C300000000000001.title: "Eye of the Eagle"
 quest.C300000000000001.quest_desc: ["The blue Eye is a true Eagle relic. Bonded players may later hunt another rare Eagle if they choose to obtain one."]
 quest.C300000000000002.title: "Storm Crystal"
 quest.C300000000000002.quest_desc: ["Capture the fury of the upper peaks in crystalline form."]
 quest.C300000000000003.title: "Ancient Talon"
 quest.C300000000000003.quest_desc: ["A relic from the oldest rulers of the peaks."]
 quest.C300000000000004.title: "Eye of the Summit"
 quest.C300000000000004.quest_desc: ["Unite the Eye of the Eagle with the other summit relics. The Eagle remains central to this progression."]
 quest.C300000000000005.title: "Golden Eagle Harness"
 quest.C300000000000005.quest_desc: ["A ceremonial harness worthy of a fully bonded Eagle."]
 quest.C300000000000006.title: "Mill the Talon"
 quest.C300000000000006.quest_desc: ["Run an Eagle Talon through Create's Millstone to produce Crushed Talon."]
 quest.C300000000000007.title: "Crush It to Dust"
 quest.C300000000000007.quest_desc: ["Run Crushed Talon through Crushing Wheels. Talon Dust is the final Compass ingredient."]

 quest.C400000000000001.title: "The Explorer's Compass"
 quest.C400000000000001.quest_desc: ["Craft the Explorer's Compass with Eagle Feather and Talon Dust in place of redstone.","&eThere is no fast travel. Locate Orduk's Cave, then make the journey yourself.&r"]
 quest.C400000000000002.title: "Find Orduk's Cave"
 quest.C400000000000002.quest_desc: ["Search the Explorer's Compass for Orduk's Cave. Gear up before entering; Orduk is tougher than the entire Eagle encounter."]
 quest.C400000000000003.title: "ORDUK, THE CAVE TROLL"
 quest.C400000000000003.quest_desc: ["&cBOSS ENCOUNTER&r","Orduk is short, broad, goblin-armored and far faster than he looks.","Learn his Ground Slam, Backhand Sweep, Troll Charge and Leap. At half health, the battle becomes a violent mountain storm."]
 quest.C400000000000004.title: "Fallen Troll"
 quest.C400000000000004.quest_desc: ["Claim Orduk's Troll Heart. Keep it safe; it will become your guide toward the Griffin's mountain."]
 quest.C400000000000005.title: "Higher Horizons"
 quest.C400000000000005.quest_desc: ["&bCURRENT PLAYABLE STORY END&r","You survived the Eagles and defeated Orduk. The Griffin is Friday's problem."]

 quest.E200000000000001.title: "Andesite Beginnings"
 quest.E200000000000001.quest_desc: ["Create begins with Andesite Alloy."]
 quest.E200000000000002.title: "Cogwheels & Shafts"
 quest.E200000000000002.quest_desc: ["Transmit rotational power through your first mechanical network."]
 quest.E200000000000003.title: "Water Power"
 quest.E200000000000003.quest_desc: ["Build a Water Wheel for dependable rotational power."]
 quest.E200000000000004.title: "The Millstone"
 quest.E200000000000004.quest_desc: ["Required for Peaks & Talons: mill Eagle Talons into Crushed Talon."]
 quest.E200000000000005.title: "Mechanical Press"
 quest.E200000000000005.quest_desc: ["Unlock automated shaping and compacting."]
 quest.E200000000000006.title: "Depot"
 quest.E200000000000006.quest_desc: ["A work surface for Create processing."]
 quest.E200000000000007.title: "Encased Fan"
 quest.E200000000000007.quest_desc: ["The heart of Create's four bulk-processing systems."]
 quest.E200000000000008.title: "Bulk Washing"
 quest.E200000000000008.quest_desc: ["Pass fan-driven air through water."]
 quest.E200000000000009.title: "Bulk Smoking"
 quest.E200000000000009.quest_desc: ["Pass fan-driven air through a Campfire."]
 quest.E20000000000000A.title: "Bulk Haunting"
 quest.E20000000000000A.quest_desc: ["Pass fan-driven air through Soul Fire."]
 quest.E20000000000000B.title: "Bulk Smelting"
 quest.E20000000000000B.quest_desc: ["Pass fan-driven air through Lava. This is the intended forge for Talon Blades."]
 quest.E20000000000000C.title: "Forge the Talon Blade"
 quest.E20000000000000C.quest_desc: ["Forge the Eagle Talon into the weapon material used by Talonspire and Talonteer."]
 quest.E20000000000000D.title: "Precision Engineering"
 quest.E20000000000000D.quest_desc: ["Build a Precision Mechanism and enter advanced Create engineering."]
 quest.E20000000000000E.title: "Mechanical Crafters"
 quest.E20000000000000E.quest_desc: ["Build a Mechanical Crafter array. Eagle Eye and Dragon Eye necklaces require machinery beyond a crafting table."]
}
