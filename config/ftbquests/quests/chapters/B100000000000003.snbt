 id:"B100000000000003"
 title:"Chapter III — Relics of the Summit"
 subtitle:"The storm guarded more than an Eagle."
 icon:{id:"peaksandtalons:eye_of_the_summit"}
 order_index:2
 quests:[
  {id:"C300000000000001" x:0.0d y:0.0d title:"The Eye of the Eagle" description:["Among the signs left by the great Eagle is an eye unlike any mortal creature's — bright with the memory of the open sky.","It is not the end of the hunt. It is a key."] icon:{id:"peaksandtalons:eye_of_the_eagle"} tasks:[{id:"D300000000000001" type:"item" item:{count:1,id:"peaksandtalons:eye_of_the_eagle"}}] rewards:[{id:"R300000000000001" type:"xp" xp:250}]}
  {id:"C300000000000002" x:0.0d y:3.0d dependencies:["C300000000000001"] title:"Heart of the Tempest" description:["The Vengeance storm leaves power trapped in crystal. Recover a Storm Crystal — lightning made solid."] icon:{id:"peaksandtalons:storm_crystal"} tasks:[{id:"D300000000000002" type:"item" item:{count:1,id:"peaksandtalons:storm_crystal"}}] rewards:[{id:"R300000000000002" type:"xp" xp:300}]}
  {id:"C300000000000003" x:0.0d y:6.0d dependencies:["C300000000000002"] title:"The Ancient Talon" description:["Not every talon belongs to a living Eagle. Deep in the high places rests a claw from an older age, worn by stone but still unnaturally sharp."] icon:{id:"peaksandtalons:ancient_talon"} tasks:[{id:"D300000000000003" type:"item" item:{count:1,id:"peaksandtalons:ancient_talon"}}] rewards:[{id:"R300000000000003" type:"xp" xp:300}]}
  {id:"C300000000000004" x:0.0d y:9.0d dependencies:["C300000000000003"] title:"Eye of the Summit" description:["Sky, storm and ancient claw answer one another. Assemble the relic that can see what ordinary travelers cannot: the path to the true Summit."] icon:{id:"peaksandtalons:eye_of_the_summit"} tasks:[{id:"D300000000000004" type:"item" item:{count:1,id:"peaksandtalons:eye_of_the_summit"}}] rewards:[{id:"R300000000000004" type:"xp" xp:550}]}
  {id:"C300000000000005" x:0.0d y:12.0d dependencies:["C300000000000004"] title:"Harness of the High King" description:["Gold alone cannot hold a creature born for the clouds. Forge the Golden Eagle Harness as a mark of mastery over the high winds."] icon:{id:"peaksandtalons:golden_eagle_harness"} tasks:[{id:"D300000000000005" type:"item" item:{count:1,id:"peaksandtalons:golden_eagle_harness"}}] rewards:[{id:"R300000000000005" type:"xp" xp:400}]}
  {id:"C300000000000006" x:-3.0d y:15.0d dependencies:["C300000000000004"] title:"Break the Talon" description:["Ancient material does not yield to ordinary hands. Reduce a talon to workable fragments and learn what the old hunters knew."] icon:{id:"peaksandtalons:crushed_talon"} tasks:[{id:"D300000000000006" type:"item" item:{count:1,id:"peaksandtalons:crushed_talon"}}] rewards:[{id:"R300000000000006" type:"xp" xp:200}]}
  {id:"C300000000000007" x:-3.0d y:18.0d dependencies:["C300000000000006"] title:"Dust of the High Peaks" description:["Grind the fragments finer. Talon Dust carries traces of the same power that lets the great Eagles rule the storm."] icon:{id:"peaksandtalons:talon_dust"} tasks:[{id:"D300000000000007" type:"item" item:{count:1,id:"peaksandtalons:talon_dust"}}] rewards:[{id:"R300000000000007" type:"xp" xp:225}]}
 ]
}
