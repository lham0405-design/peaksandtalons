{
 filename:"B100000000000002"
 group:"A100000000000001"
 id:"B100000000000002"
 title:"Chapter II — Lord of the Skies"
 subtitle:"Quarry or companion. Choose before the storm chooses for you."
 icon:{id:"peaksandtalons:eagle_feather"}
 order_index:1
 quests:[
  {id:"C200000000000001" x:0.0d y:0.0d title:"A Feather on the Wind" description:["High above the pines, something enormous circles the ridges. Find proof that the stories are true.","From this point forward your actions matter. The Eagle can become your quarry or your companion — never both in the same journey."] icon:{id:"peaksandtalons:eagle_feather"} tasks:[{id:"D200000000000001" type:"item" item:{count:1,id:"peaksandtalons:eagle_feather"}}] rewards:[{id:"R200000000000001" type:"xp" xp:125}]}
  {id:"C200000000000002" x:-3.5d y:3.0d dependencies:["C200000000000001"] title:"PATH OF THE HUNTER — Draw Blood" description:["EXCLUSIVE PATH: attacking the Eagle declares it your quarry.","The first strike begins a boss encounter. Come prepared; the sky will remember what you have done."] icon:{id:"minecraft:iron_sword"} tasks:[{id:"D200000000000002" type:"advancement" advancement:"peaksandtalons:eagle/hunter_path"}] rewards:[{id:"R200000000000002" type:"xp" xp:200}]}
  {id:"C200000000000003" x:-3.5d y:6.0d dependencies:["C200000000000002"] title:"Vengeance of the Sky" description:["The first Eagle falls — and the mountain answers.","Rain smothers the peaks. Thunder rolls. Lightning tears the clouds as three enraged Eagles descend. Survive the Vengeance phase and finish what you started."] icon:{id:"peaksandtalons:eye_of_the_eagle"} tasks:[{id:"D200000000000003" type:"advancement" advancement:"peaksandtalons:eagle/vengeance_defeated"}] rewards:[{id:"R200000000000003" type:"xp" xp:500},{id:"R200000000000013" type:"item" item:{count:2,id:"peaksandtalons:eagle_feather"}}]}
  {id:"C200000000000004" x:3.5d y:3.0d dependencies:["C200000000000001"] title:"PATH OF THE BOND — An Open Hand" description:["EXCLUSIVE PATH: do not harm the Eagle.","Offer salmon and wait for signs of acceptance. Hearts mean only that it will allow the trial to begin — not that it has been tamed."] icon:{id:"minecraft:salmon"} tasks:[{id:"D200000000000004" type:"advancement" advancement:"peaksandtalons:eagle/bond_path"}] rewards:[{id:"R200000000000004" type:"xp" xp:200},{id:"R200000000000014" type:"item" item:{count:4,id:"minecraft:salmon"}}]}
  {id:"C200000000000005" x:3.5d y:6.0d dependencies:["C200000000000004"] title:"The Taming Trial" description:["Climb onto the untamed Eagle and endure.","It will climb, dive, buck and try to throw you. Each successful attempt earns more trust. Failure should cost courage — not make mounting impossible."] icon:{id:"minecraft:saddle"} tasks:[{id:"D200000000000005" type:"advancement" advancement:"peaksandtalons:eagle/tamed"}] rewards:[{id:"R200000000000005" type:"xp" xp:450},{id:"R200000000000015" type:"item" item:{count:1,id:"minecraft:saddle"}}]}
  {id:"C200000000000006" x:3.5d y:9.0d dependencies:["C200000000000005"] title:"Take to the Skies" description:["The Eagle finally lowers its wings for you. Fit its harness, mount up and complete your first controlled flight.","You gave up the Hunter's spoils for something rarer: the loyalty of the Lord of the Skies."] icon:{id:"peaksandtalons:golden_eagle_harness"} tasks:[{id:"D200000000000006" type:"advancement" advancement:"peaksandtalons:eagle/first_flight"}] rewards:[{id:"R200000000000006" type:"xp" xp:400}]}
  {id:"C200000000000007" x:0.0d y:12.0d dependencies:["C200000000000003","C200000000000006"] dependency_requirement:"one_completed" title:"What the Eagle Leaves Behind" description:["Whether won through battle or bond, the Eagle has changed your journey. Its relics point toward older powers hidden in the highest stone.","The trail now leads toward the Summit."] icon:{id:"peaksandtalons:eagle_talon"} tasks:[{id:"D200000000000007" type:"item" item:{count:1,id:"peaksandtalons:eagle_talon"}}] rewards:[{id:"R200000000000007" type:"xp" xp:250}]}
 ]
}
