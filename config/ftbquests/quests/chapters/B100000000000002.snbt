  {id:"C200000000000001" title:"The Call of the Peaks" description:["Mountain Eagles are rare. Search the highest peaks and watch the sky.","Your next choice matters: Hunt the eagle, or earn its trust through Bond."] x:0.0d y:0.0d icon:{id:"peaksandtalons:eagle_feather"} max_completable_dependents:1 tasks:[{id:"D200000000000001" type:"item" item:{count:1,id:"peaksandtalons:eagle_feather"}}] rewards:[{id:"R200000000000001" type:"xp" xp:100}]}
  {id:"C200000000000002" title:"HUNT — Challenge the Eagle" description:["§cCHOICE: HUNT§r","Killing the eagle commits you to the combat route. Be ready for what answers its death."] x:-3.0d y:2.0d dependencies:["C200000000000001"] icon:{id:"minecraft:iron_sword"} tasks:[{id:"D200000000000002" type:"advancement" advancement:"peaksandtalons:eagle/hunter_path"}] rewards:[{id:"R200000000000002" type:"xp" xp:200}]}
