  {id:"C200000000000004" title:"BOND — Earn Its Trust" description:["§aCHOICE: BOND§r","Approach with salmon and patience. A wild mountain eagle does not surrender its trust easily."] x:3.0d y:2.0d dependencies:["C200000000000001"] icon:{id:"minecraft:salmon"} tasks:[{id:"D200000000000004" type:"advancement" advancement:"peaksandtalons:eagle/bond_path"}] rewards:[{id:"R200000000000004" type:"xp" xp:200}]}
