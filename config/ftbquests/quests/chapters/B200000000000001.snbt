 id:"B200000000000001"
 title:"Create Engineering — Power to Precision"
 subtitle:"Learn the machines that forge legendary equipment."
 icon:{id:"create:mechanical_crafter"}
 order_index:0
 quests:[
  {id:"E200000000000001" x:0.0d y:0.0d title:"Andesite Beginnings" description:["Create begins with humble stone and iron. Make Andesite Alloy — the backbone of your first machines."] icon:{id:"create:andesite_alloy"} tasks:[{id:"F200000000000001" type:"item" item:{count:8,id:"create:andesite_alloy"}}] rewards:[{id:"A200000000000001" type:"xp" xp:100},{id:"A200000000000002" type:"item" item:{count:8,id:"create:shaft"}}]}
  {id:"E200000000000002" x:0.0d y:2.5d dependencies:["E200000000000001"] title:"Turn the World" description:["Shafts and cogwheels carry rotational force. Learn the language of Create: direction, speed and stress."] icon:{id:"create:cogwheel"} tasks:[{id:"F200000000000002" type:"item" item:{count:4,id:"create:cogwheel"}}] rewards:[{id:"A200000000000003" type:"xp" xp:125},{id:"A200000000000004" type:"item" item:{count:2,id:"create:large_cogwheel"}}]}
  {id:"E200000000000003" x:0.0d y:5.0d dependencies:["E200000000000002"] title:"Power from the River" description:["A machine without rotation is sculpture. Build a Water Wheel and give your workshop its first reliable source of power."] icon:{id:"create:water_wheel"} tasks:[{id:"F200000000000003" type:"item" item:{count:1,id:"create:water_wheel"}}] rewards:[{id:"A200000000000005" type:"xp" xp:150},{id:"A200000000000006" type:"item" item:{count:8,id:"create:shaft"}}]}
  {id:"E200000000000004" x:0.0d y:7.5d dependencies:["E200000000000003"] title:"The Millstone" description:["Rotation can do more than move. Put it to work grinding materials with a Millstone."] icon:{id:"create:millstone"} tasks:[{id:"F200000000000004" type:"item" item:{count:1,id:"create:millstone"}}] rewards:[{id:"A200000000000007" type:"xp" xp:175},{id:"A200000000000008" type:"item" item:{count:4,id:"create:andesite_alloy"}}]}
  {id:"E200000000000005" x:0.0d y:10.0d dependencies:["E200000000000004"] title:"Mechanical Pressure" description:["Build a Mechanical Press. Controlled force opens an entirely new class of recipes and prepares you for automated processing."] icon:{id:"create:mechanical_press"} tasks:[{id:"F200000000000005" type:"item" item:{count:1,id:"create:mechanical_press"}}] rewards:[{id:"A200000000000009" type:"xp" xp:200},{id:"A20000000000000A" type:"item" item:{count:2,id:"create:andesite_casing"}}]}
  {id:"E200000000000006" x:0.0d y:12.5d dependencies:["E200000000000005"] title:"A Place to Process" description:["The Depot gives Create machines a controlled place to work. Pair it with your growing workshop."] icon:{id:"create:depot"} tasks:[{id:"F200000000000006" type:"item" item:{count:1,id:"create:depot"}}] rewards:[{id:"A20000000000000B" type:"xp" xp:150},{id:"A20000000000000C" type:"item" item:{count:1,id:"create:wrench"}}]}
  {id:"E200000000000007" x:0.0d y:15.0d dependencies:["E200000000000006"] title:"Harness the Fan" description:["Build an Encased Fan. What passes through its airflow depends on what you place in front of it — water, fire, soul fire or lava."] icon:{id:"create:encased_fan"} tasks:[{id:"F200000000000007" type:"item" item:{count:1,id:"create:encased_fan"}}] rewards:[{id:"A20000000000000D" type:"xp" xp:225},{id:"A20000000000000E" type:"item" item:{count:2,id:"create:depot"}}]}
  {id:"E200000000000008" x:-4.5d y:18.0d dependencies:["E200000000000007"] title:"Bulk Washing" description:["Blow fan air through water to wash whole stacks of materials at once."] icon:{id:"minecraft:water_bucket"} tasks:[{id:"F200000000000008" type:"item" item:{count:1,id:"minecraft:water_bucket"}}] rewards:[{id:"A20000000000000F" type:"xp" xp:175}]}
  {id:"E200000000000009" x:-1.5d y:18.0d dependencies:["E200000000000008"] title:"Bulk Smoking" description:["Pass fan air through ordinary fire to smoke food and compatible materials in bulk."] icon:{id:"minecraft:campfire"} tasks:[{id:"F200000000000009" type:"item" item:{count:1,id:"minecraft:campfire"}}] rewards:[{id:"A200000000000011" type:"xp" xp:175}]}
  {id:"E20000000000000A" x:1.5d y:18.0d dependencies:["E200000000000009"] title:"Bulk Haunting" description:["Soul fire twists matter instead of merely heating it. Learn Bulk Haunting before attempting the hottest process."] icon:{id:"minecraft:soul_campfire"} tasks:[{id:"F20000000000000A" type:"item" item:{count:1,id:"minecraft:soul_campfire"}}] rewards:[{id:"A200000000000013" type:"xp" xp:225}]}
  {id:"E20000000000000B" x:4.5d y:18.0d dependencies:["E20000000000000A"] title:"Bulk Smelting" description:["Lava-heated airflow becomes a forge. Build the Bulk Smelter — this is the only heat fierce and controlled enough to forge an Eagle Talon into a Talon Blade."] icon:{id:"minecraft:lava_bucket"} tasks:[{id:"F20000000000000B" type:"item" item:{count:1,id:"minecraft:lava_bucket"}}] rewards:[{id:"A200000000000015" type:"xp" xp:250}]}
  {id:"E20000000000000C" x:0.0d y:21.0d dependencies:["E20000000000000B"] title:"Forge the Talon" description:["Place an Eagle Talon into your Bulk Smelter. Under the furnace-hot airflow the claw yields, becoming a weapon-grade Talon Blade."] icon:{id:"peaksandtalons:talon_blade"} tasks:[{id:"F20000000000000C" type:"item" item:{count:1,id:"peaksandtalons:talon_blade"}}] rewards:[{id:"A200000000000017" type:"xp" xp:350},{id:"A200000000000018" type:"item" item:{count:4,id:"create:brass_ingot"}}]}
  {id:"E20000000000000D" x:0.0d y:24.0d dependencies:["E20000000000000C"] title:"Precision Engineering" description:["Your machines are no longer crude. Assemble a Precision Mechanism and enter Create's advanced engineering tier."] icon:{id:"create:precision_mechanism"} tasks:[{id:"F20000000000000D" type:"item" item:{count:1,id:"create:precision_mechanism"}}] rewards:[{id:"A200000000000019" type:"xp" xp:400}]}
  {id:"E20000000000000E" x:0.0d y:27.0d dependencies:["E20000000000000D"] title:"The Mechanical Crafter" description:["Legendary artifacts cannot be assembled by hand. Build a Mechanical Crafter array.","The Eagle Eye Necklace and Dragon's Eye Necklace are locked behind this machine. Reaching this point reconnects Create engineering with the main Peaks & Talons progression."] icon:{id:"create:mechanical_crafter"} tasks:[{id:"F20000000000000E" type:"item" item:{count:9,id:"create:mechanical_crafter"}}] rewards:[{id:"A20000000000001B" type:"xp" xp:500},{id:"A20000000000001C" type:"item" item:{count:16,id:"create:cogwheel"}}]}
 ]
