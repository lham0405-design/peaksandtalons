 quests:[
  {id:"C400000000000001" title:"The Explorer's Compass" description:["Your Eagle path has earned the knowledge and materials to move deeper into the mountains.","Craft the Explorer's Compass using Eagle Feather and Talon Dust in place of redstone.","§eThe compass LOCATES structures only. There is no fast travel — you must make the journey yourself.§r"] x:0.0d y:0.0d icon:{id:"explorerscompass:explorerscompass"} tasks:[{id:"D400000000000001" type:"item" item:{count:1,id:"explorerscompass:explorerscompass"}}] rewards:[{id:"R400000000000001" type:"xp" xp:300}]}
  {id:"C400000000000002" title:"Find Orduk's Cave" description:["Open the Explorer's Compass and search for §6Orduk's Cave§r.","Travel there physically. Gear up before entering; Orduk is tougher than the entire Eagle encounter."] x:0.0d y:3.0d dependencies:["C400000000000001"] icon:{id:"minecraft:pointed_dripstone"} tasks:[{id:"D400000000000002" type:"item" item:{count:16,id:"minecraft:torch"}}] rewards:[{id:"R400000000000002" type:"xp" xp:200}]}
  {id:"C400000000000003" title:"ORDUK, THE CAVE TROLL" description:["§cBOSS ENCOUNTER§r","Orduk is short, broad, armored and far faster than he looks.","Learn his Ground Slam, Backhand Sweep, Troll Charge and Leap. Ranged camping will not make this fight safe.","At roughly half health the battle becomes a violent mountain storm. Watch the arena as well as the troll."] x:0.0d y:6.0d dependencies:["C400000000000002"] icon:{id:"minecraft:iron_axe"} tasks:[{id:"D400000000000003" type:"kill" entity:"peaksandtalons:orduk" value:1L}] rewards:[{id:"R400000000000003" type:"xp" xp:1000}]}
  {id:"C400000000000004" title:"Fallen Troll" description:["Orduk falls, but the mountain is not finished with you.","Claim his Troll Heart. Keep it safe — this relic will become your guide to the Griffin's mountain in the next chapter of development."] x:0.0d y:9.0d dependencies:["C400000000000003"] icon:{id:"peaksandtalons:troll_heart"} tasks:[{id:"D400000000000004" type:"item" item:{count:1,id:"peaksandtalons:troll_heart"}}] rewards:[{id:"R400000000000004" type:"xp" xp:750}]}
  {id:"C400000000000005" title:"Higher Horizons" description:["§bCURRENT PLAYABLE STORY END§r","You have survived the Eagles and defeated Orduk.","The Troll Heart points toward something greater. The Griffin awaits in a future build."] x:0.0d y:12.0d dependencies:["C400000000000004"] icon:{id:"minecraft:nether_star"} tasks:[{id:"D400000000000005" type:"item" item:{count:1,id:"peaksandtalons:troll_heart"}}] rewards:[{id:"R400000000000005" type:"xp" xp:500}]}
