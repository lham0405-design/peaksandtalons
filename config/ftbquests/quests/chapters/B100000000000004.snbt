 id:"B100000000000004"
 title:"Chapter IV — Beneath the Mountain"
 subtitle:"The oldest danger does not have wings."
 icon:{id:"peaksandtalons:troll_heart"}
 order_index:3
 quests:[
  {id:"C400000000000001" x:0.0d y:0.0d title:"Whispers Under Stone" description:["The Eye of the Summit reveals something unsettling: the mountain is hollow.","The Troll Heart recovered at the Summit is your key. Hold it, face the direction you wish to search, and RIGHT-CLICK. Do not throw it with Q — Q only drops the item."] icon:{id:"peaksandtalons:troll_heart"} tasks:[{id:"D400000000000001" type:"item" item:{count:1,id:"peaksandtalons:troll_heart"}}] rewards:[{id:"R400000000000001" type:"xp" xp:300},{id:"R400000000000011" type:"item" item:{count:16,id:"minecraft:torch"}}]}
  {id:"C400000000000002" x:0.0d y:3.0d dependencies:["C400000000000001"] hide_until_deps_complete:true title:"Follow the Heart" description:["Right-click the Troll Heart. Its heartbeat and soul-fire trail reveal Orduk's Hollow beneath the mountain.","The Hollow is not a single room: descend the broad stair, search the ruined tiers and four side alcoves for supplies, then enter the central arena when you are prepared."] icon:{id:"minecraft:soul_lantern"} tasks:[{id:"D400000000000002" type:"item" item:{count:1,id:"peaksandtalons:troll_heart"}}] rewards:[{id:"R400000000000002" type:"xp" xp:300},{id:"R400000000000012" type:"item" item:{count:8,id:"minecraft:cooked_beef"}}]}
  {id:"C400000000000003" x:0.0d y:6.0d dependencies:["C400000000000002"] hide_until_deps_complete:true title:"The Mountain Wakes" description:["At the center of the Hollow waits ORDUK, THE CAVE TROLL.","Expect a true boss encounter: crushing melee, knockback, ground-slam pressure, lunges and ranged punishment. At roughly half health the Hollow enters its storm phase and lightning turns the arena against you.","Defeat Orduk and silence the thing below."] icon:{id:"minecraft:iron_axe"} tasks:[{id:"D400000000000003" type:"kill" entity:"peaksandtalons:orduk" value:1L}] rewards:[{id:"R400000000000003" type:"xp" xp:1000},{id:"R400000000000013" type:"item" item:{count:2,id:"minecraft:golden_apple"}}]}
  {id:"C400000000000004" x:0.0d y:9.0d dependencies:["C400000000000003"] hide_until_deps_complete:true title:"Heart of Orduk" description:["Orduk falls, leaving behind a heart unlike the Troll Heart that guided you here. This unique relic is proof that you survived the Hollow and claimed the power beneath the mountain."] icon:{id:"peaksandtalons:heart_of_orduk"} tasks:[{id:"D400000000000004" type:"item" item:{count:1,id:"peaksandtalons:heart_of_orduk"}}] rewards:[{id:"R400000000000004" type:"xp" xp:750}]}
  {id:"C400000000000005" x:0.0d y:12.0d dependencies:["C400000000000004"] hide_until_deps_complete:true title:"Master of Peak and Hollow" description:["You have faced the ruler of the sky and the terror beneath the stone. The peaks no longer feel like a place you merely visit.","They know your name now. The next great hunt will carry you beyond eagle and troll — toward the Griffin."] icon:{id:"peaksandtalons:heart_of_orduk"} tasks:[{id:"D400000000000005" type:"item" item:{count:1,id:"peaksandtalons:heart_of_orduk"}}] rewards:[{id:"R400000000000005" type:"xp" xp:750},{id:"R400000000000015" type:"item" item:{count:1,id:"minecraft:nether_star"}}]}
 ]
}
