 quests:[
  {id:"C400000000000001" x:0.0d y:0.0d title:"The Explorer's Compass" description:["The relics earned through the Eagle and Summit progression point toward an older threat hidden inside the mountain.","Prepare an Explorer's Compass. It is both your guide to Orduk's Hollow and the offering required to awaken the creature beneath it."] icon:{id:"explorerscompass:explorerscompass"} tasks:[{id:"D400000000000001" type:"item" item:{count:1,id:"explorerscompass:explorerscompass"}}] rewards:[{id:"R400000000000001" type:"xp" xp:300},{id:"R400000000000011" type:"item" item:{count:16,id:"minecraft:torch"}}]}
  {id:"C400000000000002" x:0.0d y:3.0d dependencies:["C400000000000001"] hide_until_deps_complete:true title:"Orduk's Hollow" description:["Use the Explorer's Compass to locate the mountain structure that shelters Orduk's Hollow.","Descend into the enormous cavern, search its ruined tiers and loot alcoves, then clear the central arena. Hostile Eagles have enough room to take flight above the floor while spiders stalk the stone below."] icon:{id:"minecraft:chiseled_deepslate"} tasks:[{id:"D400000000000002" type:"item" item:{count:1,id:"explorerscompass:explorerscompass"}}] rewards:[{id:"R400000000000002" type:"xp" xp:350},{id:"R400000000000012" type:"item" item:{count:8,id:"minecraft:cooked_beef"}}]}
  {id:"C400000000000003" x:0.0d y:6.0d dependencies:["C400000000000002"] hide_until_deps_complete:true title:"The Offering Podium" description:["At the center of the cleared arena stands an ancient carved podium with a compass-shaped recess.","Defeat the arena guardians first. Then hold the Explorer's Compass and right-click the podium. The compass is consumed as the offering, and Orduk awakens."] icon:{id:"explorerscompass:explorerscompass"} tasks:[{id:"D400000000000003" type:"item" item:{count:1,id:"explorerscompass:explorerscompass"}}] rewards:[{id:"R400000000000003" type:"xp" xp:250}]}
  {id:"C400000000000004" x:0.0d y:9.0d dependencies:["C400000000000003"] hide_until_deps_complete:true title:"The Mountain Wakes" description:["Submitting the compass begins the true encounter: ORDUK, THE CAVE TROLL.","Expect crushing melee, knockback, ground-slam pressure, lunges and ranged punishment. At roughly half health the Hollow enters its storm phase and lightning turns the arena against you.","Defeat Orduk and claim the one relic that can carry the hunt beyond the Hollow."] icon:{id:"minecraft:iron_axe"} tasks:[{id:"D400000000000004" type:"kill" entity:"peaksandtalons:orduk" value:1L}] rewards:[{id:"R400000000000004" type:"xp" xp:1000},{id:"R400000000000014" type:"item" item:{count:2,id:"minecraft:golden_apple"}}]}
  {id:"C400000000000005" x:0.0d y:12.0d dependencies:["C400000000000004"] hide_until_deps_complete:true title:"Heart of Orduk" description:["Orduk leaves behind a single Heart of Orduk. There is no earlier Troll Heart — this is the unique boss relic.","Right-click the heart to release its supernatural directional pulse. Its heartbeat and soul-fire trail point the expedition toward the next great predator: the Griffin."] icon:{id:"peaksandtalons:heart_of_orduk"} tasks:[{id:"D400000000000005" type:"item" item:{count:1,id:"peaksandtalons:heart_of_orduk"}}] rewards:[{id:"R400000000000005" type:"xp" xp:750}]}
 ]
