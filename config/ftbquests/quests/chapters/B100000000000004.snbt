 title:"Chapter IV — Beneath the Mountain"
 subtitle:"The oldest danger does not have wings."
 icon:{id:"peaksandtalons:troll_heart"}
 order_index:3
 quests:[
  {id:"C400000000000001" x:0.0d y:0.0d title:"Whispers Under Stone" description:["The Eye of the Summit reveals something unsettling: the mountain is hollow.","Old trail markers speak one name — Orduk — and warn that the thing beneath the peaks was ancient before the Eagles claimed the sky."] icon:{id:"explorerscompass:explorerscompass"} tasks:[{id:"D400000000000001" type:"item" item:{count:1,id:"explorerscompass:explorerscompass"}}] rewards:[{id:"R400000000000001" type:"xp" xp:300},{id:"R400000000000011" type:"item" item:{count:16,id:"minecraft:torch"}}]}
  {id:"C400000000000002" x:0.0d y:3.0d dependencies:["C400000000000001"] title:"Orduk's Hollow" description:["Follow the signs beneath the mountain. When natural stone gives way to an impossible cavern, you have found the troll's domain.","Do not mistake silence for safety."] icon:{id:"minecraft:pointed_dripstone"} tasks:[{id:"D400000000000002" type:"structure" structure:"peaksandtalons:orduks_cave"}] rewards:[{id:"R400000000000002" type:"xp" xp:300}]}
  {id:"C400000000000003" x:0.0d y:6.0d dependencies:["C400000000000002"] title:"The Mountain Wakes" description:["Orduk has endured beneath these peaks longer than any living traveler remembers. In the confines of his cavern there is nowhere to outrun him.","Defeat Orduk and silence the thing below."] icon:{id:"minecraft:iron_axe"} tasks:[{id:"D400000000000003" type:"kill" entity:"peaksandtalons:orduk" value:1L}] rewards:[{id:"R400000000000003" type:"xp" xp:1000}]}
  {id:"C400000000000004" x:0.0d y:9.0d dependencies:["C400000000000003"] title:"Heart of Orduk" description:["The troll falls, but its heart refuses to cool. Take it. Whatever power sustained Orduk now belongs to the expedition."] icon:{id:"peaksandtalons:troll_heart"} tasks:[{id:"D400000000000004" type:"item" item:{count:1,id:"peaksandtalons:troll_heart"}}] rewards:[{id:"R400000000000004" type:"xp" xp:750}]}
  {id:"C400000000000005" x:0.0d y:12.0d dependencies:["C400000000000004"] title:"Master of Peak and Hollow" description:["You have faced the ruler of the sky and the terror beneath the stone. The peaks no longer feel like a place you merely visit.","They know your name now."] icon:{id:"minecraft:nether_star"} tasks:[{id:"D400000000000005" type:"item" item:{count:1,id:"peaksandtalons:troll_heart"}}] rewards:[{id:"R400000000000005" type:"xp" xp:750},{id:"R400000000000015" type:"item" item:{count:1,id:"minecraft:nether_star"}}]}
 ]
}
